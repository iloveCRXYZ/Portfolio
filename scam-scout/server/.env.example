# Copy to .env and fill in. Never commit the real .env.
PORT=4000
HOST=0.0.0.0
# Long random string used to sign login tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me
# SQLite file. Use :memory: for a throwaway database.
DATABASE_PATH=./data/scam-scout.db

# Sign in with Google: comma-separated OAuth client IDs (iOS, Android and web) that may sign in.
GOOGLE_CLIENT_IDS=
# Sign in with Apple: your iOS bundle identifier, e.g. com.yourname.scamscout
APPLE_BUNDLE_ID=

# Development helpers. Leave unset in production.
# 1 = when nobody else is queuing, ranked matchmaking pairs you with a practice bot after 15 seconds.
MATCH_BOTS=1
# 1 = email confirmation and password reset links are printed to the server log and returned in API responses.
DEV_EMAIL_LINKS=1
